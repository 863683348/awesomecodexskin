---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site.ts';
import { SUPPORTED_LOCALES, type Locale, DEFAULT_LOCALE, RTL_LOCALES, LOCALE_HREFLANG, stripLocale, localizedPath } from '../i18n/config.ts';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  jsonLd?: object | object[];
  locale?: Locale;
}

const { title, description, image, type = 'website', jsonLd, locale = DEFAULT_LOCALE } = Astro.props;

// Current path WITHOUT the locale prefix (e.g. /skins/clear-glass/)
const cleanPath = stripLocale(Astro.url.pathname);
// canonical: localized absolute URL
const canonicalURL = new URL(localizedPath(cleanPath, locale), Astro.site);
// OG image: skin detail pages pass previewImage; everything else uses the themed default
const ogImage = image
  ? new URL(localizedPath(image, locale), Astro.site)
  : new URL('/og/default.svg', Astro.site);
const isRTL = RTL_LOCALES.has(locale);
---
<!doctype html>
<html lang={locale} dir={isRTL ? 'rtl' : 'ltr'} data-theme="dark">
  <head>
    <!-- Anti-FOUC boot script: set data-theme before first paint, persist choice -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = 'dark'; // default = dark
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- hreflang alternates: one per supported locale, x-default = English root -->
    {SUPPORTED_LOCALES.map((l) => (
      <link rel="alternate" hreflang={LOCALE_HREFLANG[l]} href={new URL(localizedPath(cleanPath, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(cleanPath, DEFAULT_LOCALE), Astro.site)} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-fg font-body">
    <a href="#main" class="sr-only">Skip to content</a>
    <Nav locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </body>
</html>
