---
import { Wand } from '@lucide/astro';
import CopyButton from './CopyButton.astro';
import { CATEGORIES } from '../lib/site.ts';

const platforms = [
  { value: 'codex-desktop', label: 'Codex Desktop' },
  { value: 'codex-cli', label: 'Codex CLI' },
  { value: 'both', label: 'Both' },
];
---
<div class="grid gap-6 lg:grid-cols-2">
  <div class="space-y-4">
    <div>
      <label class="field-label" for="pg-name">Skin name</label>
      <input id="pg-name" class="field-input" placeholder="Aurora Midnight" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="field-label" for="pg-category">Category</label>
        <select id="pg-category" class="field-input">
          {CATEGORIES.map((c) => <option value={c.label}>{c.label}</option>)}
        </select>
      </div>
      <div>
        <label class="field-label" for="pg-platform">Platform</label>
        <select id="pg-platform" class="field-input">
          {platforms.map((p) => <option value={p.label}>{p.label}</option>)}
        </select>
      </div>
    </div>
    <div>
      <label class="field-label" for="pg-mood">Mood</label>
      <input id="pg-mood" class="field-input" placeholder="calm, neon" />
    </div>
    <div>
      <label class="field-label" for="pg-color">Accent color</label>
      <input id="pg-color" type="color" value="#2DD4BF" class="h-10 w-16 cursor-pointer rounded-t-sm border border-border bg-surface" />
    </div>
  </div>

  <div>
    <label class="field-label" for="pg-out">Generated prompt</label>
    <pre id="pg-out" class="min-h-[12rem] overflow-x-auto rounded-t-md border border-border bg-surface-warm p-4 font-mono text-sm text-fg"></pre>
    <div class="mt-3">
      <CopyButton text="" label="Copy prompt" id="pg-copy" />
    </div>
  </div>
</div>

<script>
  const name = document.getElementById('pg-name') as HTMLInputElement | null;
  const category = document.getElementById('pg-category') as HTMLSelectElement | null;
  const platform = document.getElementById('pg-platform') as HTMLSelectElement | null;
  const mood = document.getElementById('pg-mood') as HTMLInputElement | null;
  const color = document.getElementById('pg-color') as HTMLInputElement | null;
  const out = document.getElementById('pg-out');
  const copyBtn = document.getElementById('pg-copy');
  const copySrc = copyBtn?.querySelector<HTMLElement>('[data-copy-text]');

  function build() {
    const n = name?.value?.trim() || 'my skin';
    const cat = category?.selectedOptions?.[0]?.textContent || 'Dark & Midnight';
    const plat = platform?.selectedOptions?.[0]?.textContent || 'Codex Desktop';
    const m = mood?.value?.trim() || 'calm';
    const c = color?.value || '#2DD4BF';
    const prompt =
      `Codex, switch my workspace to "${n}" — a ${m} ${cat.toLowerCase()} skin for ${plat}. ` +
      `Use ${c} as the accent color and keep the interface readable.`;
    if (out) out.textContent = prompt;
    if (copySrc) copySrc.textContent = prompt;
  }

  [name, category, platform, mood, color].forEach((el) => {
    el?.addEventListener('input', build);
    el?.addEventListener('change', build);
  });
  build();
</script>
