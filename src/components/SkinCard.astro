---
import { ImageOff, ArrowUpRight, User, Download } from '@lucide/astro';
import CopyButton from './CopyButton.astro';
import { categoryLabel } from '../lib/site.ts';
import type { Skin } from '../lib/skins.ts';

interface Props {
  skin: Skin;
  compact?: boolean;
}
const { skin, compact = false } = Astro.props;
const d = skin.data;
const detail = `/skins/${skin.id}`;

// preview image present → render it (with onerror fallback); otherwise fallback block
const hasPreview = Boolean(d.previewImage);
const updatedISO = d.updatedAt.toISOString();
---
<article
  class="skin-card relative flex flex-col overflow-hidden rounded-t-md border border-border bg-surface"
  data-category={d.category}
  data-mood={d.mood}
  data-platform={d.platform}
  data-name={d.name}
  data-author={d.author}
  data-color={d.color}
  data-installs={d.stats.installs}
  data-likes={d.stats.likes}
  data-updated={updatedISO}
>
  <a href={detail} class="thumb-link block" aria-label={d.name}>
    <div class="relative aspect-video w-full overflow-hidden bg-surface-warm">
      {hasPreview ? (
        <img
          src={d.previewImage}
          alt={`${d.name} preview`}
          loading="lazy"
          class="h-full w-full object-cover"
          data-skin-color={d.color}
          onerror={`this.style.display='none'; this.nextElementSibling.style.display='flex';`}
        />
      ) : null}
      <div
        class={`absolute inset-0 flex-col items-center justify-center gap-2 text-meta ${hasPreview ? 'hidden' : 'flex'}`}
        style={`--skin-color:${d.color}`}
      >
        <ImageOff size={24} />
        <span class="px-4 text-center text-xs">Source may have changed</span>
      </div>
    </div>
  </a>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-lg font-semibold text-fg">
        <a href={detail} class="card-link">{d.name}</a>
      </h3>
      <span class="color-dot" style={`--skin-color:${d.color}`} title={`Accent ${d.color}`} aria-hidden="true"></span>
    </div>

    <p class={`mt-1 text-sm text-muted ${compact ? '' : 'line-clamp-2'}`}>{d.description}</p>

    <div class="mt-3 flex flex-wrap gap-2">
      <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{categoryLabel(d.category)}</span>
      <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{d.mood}</span>
    </div>

    <div class="mt-3 flex items-center gap-4 text-xs text-meta">
      <span class="inline-flex items-center gap-1"><User size={14} /> {d.author}</span>
      <span class="inline-flex items-center gap-1"><Download size={14} /> {d.stats.installs.toLocaleString()} installs</span>
    </div>
  </div>

  <div class="overlay flex items-center gap-2 border-t border-border p-3">
    <CopyButton text={d.installPrompt} label="Copy prompt" class="flex-1 justify-center" />
    <a
      href={detail}
      class="inline-flex items-center gap-1 rounded-t-sm border border-border px-3 py-2 text-sm text-fg hover:border-accent hover:text-accent"
    >View <ArrowUpRight size={16} /></a>
  </div>
</article>
