---
import { ExternalLink } from '@lucide/astro';
import { ENGINES } from '../lib/site.ts';
---
<section aria-label="Engines and tools" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {ENGINES.map((e) => (
    <article class="flex flex-col rounded-t-md border border-border bg-surface p-4">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-semibold text-fg">{e.name}</h3>
        <a href={e.url} class="text-muted hover:text-accent" rel="nofollow noopener" target="_blank" aria-label={`Open ${e.name} on GitHub`}>
          <ExternalLink size={18} />
        </a>
      </div>
      <p class="mt-2 flex-1 text-sm text-muted">{e.note}</p>
      <div class="mt-3 flex items-center gap-1 text-xs text-meta">
        <span class="rounded-t-pill border border-border px-2 py-0.5">{e.platforms}</span>
      </div>
    </article>
  ))}
</section>
