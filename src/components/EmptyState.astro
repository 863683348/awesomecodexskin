---
import { SearchX, PackageOpen } from '@lucide/astro';
interface Props {
  variant?: 'no-results' | 'empty-index';
}
const { variant = 'no-results' } = Astro.props;
const Icon = variant === 'empty-index' ? PackageOpen : SearchX;
const title = variant === 'empty-index' ? 'The index is warming up' : 'No skins match';
const body =
  variant === 'empty-index'
    ? 'The index is warming up — submit the first skin.'
    : 'No skins match — clear filters / submit the first.';
---
<div class="flex flex-col items-center justify-center gap-4 py-16 text-center" id="empty-state" style="display:none">
  <Icon size={24} class="text-muted" />
  <div>
    <h2 class="text-xl font-semibold text-fg">{title}</h2>
    <p class="mt-1 text-base text-muted">{body}</p>
  </div>
  <div class="mt-2 flex items-center gap-3">
    <button
      type="button"
      id="empty-clear"
      class="rounded-t-pill bg-accent px-4 py-2 text-sm font-medium text-accent-on hover:bg-accent-hover"
    >Clear filters</button>
    <a
      href="/submit"
      class="rounded-t-pill border border-border px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent"
    >Submit a skin</a>
  </div>
</div>

<script>
  const clearBtn = document.getElementById('empty-clear');
  clearBtn?.addEventListener('click', () => {
    document
      .querySelectorAll<HTMLInputElement>('[data-facet]')
      .forEach((el) => {
        if (el.type === 'checkbox') el.checked = false;
        else el.value = '';
        el.dispatchEvent(new Event('change'));
        el.dispatchEvent(new Event('input'));
      });
    document
      .querySelectorAll<HTMLInputElement>('input[data-search]')
      .forEach((el) => {
        el.value = '';
        el.dispatchEvent(new Event('input'));
      });
  });
</script>
