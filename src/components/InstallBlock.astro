---
import { Download, ExternalLink, Link as LinkIcon, FileCode } from '@lucide/astro';
import CopyButton from './CopyButton.astro';
import type { Skin } from '../lib/skins.ts';
import { type Locale, DEFAULT_LOCALE } from '../i18n/config.ts';
import { makeT } from '../i18n/index.ts';

interface Props {
  skin: Skin;
  locale?: Locale;
}
const { skin, locale = DEFAULT_LOCALE } = Astro.props;
const t = makeT(locale);
const d = skin.data;
const fmt = d.installFormat;
const sourceHref = d.sourceUrl;
---
<section
  class="rounded-t-md border border-border bg-surface-warm p-4"
  aria-label={t('skin.install')}
>
  <div class="flex items-center justify-between gap-3">
    <div class="flex items-center gap-2 text-meta">
      <FileCode size={16} />
      <span class="text-xs font-semibold tracking-caps uppercase">
        {fmt === 'tmtheme' ? t('skin.installCommand') : fmt === 'codedrobe-theme' ? t('skin.downloadTheme') : t('skin.installPrompt')}
      </span>
    </div>
    {fmt !== 'manual' && fmt !== 'codedrobe-theme' && (
      <CopyButton text={d.installPrompt} label={t('skin.copyLabel')} />
    )}
  </div>

  {fmt === 'manual' ? (
    <div class="mt-3 flex items-center gap-2 text-sm text-muted">
      <LinkIcon size={16} />
      <span>{t('skin.installFromSource')}</span>
      <a href={sourceHref} class="inline-flex items-center gap-1 text-accent hover:underline" rel="nofollow noopener" target="_blank">
        {t('skin.seeSource')} <ExternalLink size={14} />
      </a>
    </div>
  ) : fmt === 'codedrobe-theme' ? (
    <div class="mt-3">
      <a
        href={sourceHref}
        class="inline-flex items-center gap-2 rounded-t-sm bg-accent px-4 py-2 text-sm font-medium text-accent-on hover:bg-accent-hover"
        rel="nofollow noopener"
        target="_blank"
      >
        <Download size={16} /> {t('skin.downloadCodedrobe')}
      </a>
      <p class="mt-2 text-xs text-meta">{t('skin.downloadHelp')}</p>
    </div>
  ) : (
    <pre class="mt-3 overflow-x-auto rounded-t-sm border border-border bg-surface p-4 font-mono text-sm text-fg"><code>{d.installPrompt}</code></pre>
  )}

  {fmt === 'dreamskin-v1' && (
    <p class="mt-2 text-xs text-meta">{t('skin.dreamskinNote')}</p>
  )}
</section>
