---
import { GitBranch, Rss } from '@lucide/astro';
import { SITE, REPO_URL, CATEGORIES } from '../lib/site.ts';
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-border bg-surface">
  <div class="container-x grid gap-10 py-12 md:grid-cols-4">
    <div class="md:col-span-1">
      <div class="font-display text-lg font-semibold text-fg">Codex Skin Index</div>
      <p class="mt-2 text-sm text-muted">{SITE.tagline}</p>
      <div class="mt-4 flex items-center gap-3">
        <a href={REPO_URL} class="inline-flex items-center gap-1 text-sm text-muted hover:text-fg" rel="nofollow noopener" target="_blank">
          <GitBranch size={16} /> GitHub
        </a>
        <a href="/rss.xml" class="inline-flex items-center gap-1 text-sm text-muted hover:text-fg">
          <Rss size={16} /> RSS
        </a>
      </div>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-caps text-meta uppercase">Categories</h2>
      <ul class="mt-3 space-y-2">
        {CATEGORIES.map((c) => (
          <li>
            <a href={`/skins/category/${c.slug}`} class="text-sm text-muted hover:text-fg">{c.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-caps text-meta uppercase">Discover</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="/skins" class="text-sm text-muted hover:text-fg">All skins</a></li>
        <li><a href="/install" class="text-sm text-muted hover:text-fg">How to install</a></li>
        <li><a href="/tutorial" class="text-sm text-muted hover:text-fg">Tutorials</a></li>
        <li><a href="/faq" class="text-sm text-muted hover:text-fg">FAQ &amp; safety</a></li>
        <li><a href="/submit" class="text-sm text-muted hover:text-fg">Submit a skin</a></li>
        <li><a href="/advertise" class="text-sm text-muted hover:text-fg">Advertise</a></li>
        <li><a href="/contact" class="text-sm text-muted hover:text-fg">Contact</a></li>
        <li><a href="/tools/theme-preview" class="text-sm text-muted hover:text-fg">Theme previewer</a></li>
        <li><a href="/tools/prompt-generator" class="text-sm text-muted hover:text-fg">Prompt generator</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold tracking-caps text-meta uppercase">Sister sites</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="https://codexpetgenerator.com" class="text-sm text-muted hover:text-fg" rel="nofollow noopener" target="_blank">Codex Pets</a></li>
        <li><a href="https://codex-skin-studio.shop" class="text-sm text-muted hover:text-fg" rel="nofollow noopener" target="_blank">Skin Generator</a></li>
      </ul>
      <p class="mt-4 text-xs text-meta">Neutral index. Not affiliated with or endorsed by OpenAI.</p>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="container-x flex flex-wrap items-center justify-between gap-2 py-4 text-xs text-meta">
      <span>© {year} {SITE.name} · EN</span>
      <span>{SITE.domain}</span>
    </div>
  </div>
</footer>
