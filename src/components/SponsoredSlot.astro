---
import { Badge, ExternalLink } from '@lucide/astro';
interface Props {
  title?: string;
  body?: string;
  href?: string;
  cta?: string;
}
const {
  title = 'Feature your engine here',
  body = 'Reach Codex skinners with a clearly-labeled sponsored slot. Honest placement, never disguised as an organic result.',
  href = '/advertise',
  cta = 'Advertise with us',
} = Astro.props;
const external = href.startsWith('http');
---
<section
  class="rounded-t-lg border border-border bg-surface-warm p-6"
  aria-label="Sponsored placement"
>
  <div class="flex items-center gap-2 text-meta">
    <Badge size={16} />
    <span class="text-xs font-semibold tracking-caps uppercase">Sponsored</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-fg">{title}</h3>
  <p class="mt-1 max-w-2xl text-sm text-muted">{body}</p>
  <a
    href={href}
    class="mt-4 inline-flex items-center gap-1 rounded-t-pill bg-accent px-4 py-2 text-sm font-medium text-accent-on hover:bg-accent-hover"
    {...(external ? { rel: 'nofollow noopener', target: '_blank' } : {})}
  >
    {cta} {external && <ExternalLink size={14} />}
  </a>
</section>
