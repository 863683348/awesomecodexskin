---
import SkinCard from './SkinCard.astro';
import type { Skin } from '../lib/skins.ts';
import { type Locale, DEFAULT_LOCALE } from '../i18n/config.ts';

interface Props {
  skin: Skin;
  all: Skin[];
  locale?: Locale;
}
const { skin, all, locale = DEFAULT_LOCALE } = Astro.props;
const related = all
  .filter((s) => s.id !== skin.id && s.data.category === skin.data.category)
  .slice(0, 4);
---
{related.length > 0 && (
  <section class="mt-12" aria-label="Related skins">
    <h2 class="mb-4 text-xl font-semibold text-fg">More in this category</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {related.map((s) => (
        <SkinCard skin={s} compact locale={locale} />
      ))}
    </div>
  </section>
)}
