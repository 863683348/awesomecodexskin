---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SkinPreview from '../../components/SkinPreview.astro';
import InstallBlock from '../../components/InstallBlock.astro';
import CompatibleBadges from '../../components/CompatibleBadges.astro';
import RelatedSkins from '../../components/RelatedSkins.astro';
import ReportLink from '../../components/ReportLink.astro';
import { User, Download, Heart, CalendarDays, ExternalLink } from '@lucide/astro';
import { operatingSystem } from '../../lib/skins.ts';
import { categoryLabel, SITE } from '../../lib/site.ts';

export async function getStaticPaths() {
  const skins = await getCollection('skins');
  return skins.map((skin) => ({
    // entry.id derived from filename by glob loader (already a string)
    params: { slug: skin.id },
    props: { skin },
  }));
}

const { skin } = Astro.props;
const { Content } = await render(skin);
const d = skin.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Skins', item: `${SITE.url}/skins/` },
        { '@type': 'ListItem', position: 3, name: d.name, item: `${SITE.url}/skins/${skin.id}/` },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: d.name,
      description: d.description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: operatingSystem(skin),
      softwareVersion: '1.0',
      downloadUrl: d.sourceUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '0',
        ratingCount: String(d.stats.likes),
      },
    },
  ],
};
---
<Base
  title={`${d.name} — Codex skin`}
  description={d.description}
  jsonLd={jsonLd}
>
  <article class="container-x py-8">
    <nav class="mb-4 text-sm text-meta" aria-label="Breadcrumb">
      <a href="/skins" class="hover:text-fg">Skins</a> /
      <a href={`/skins/category/${d.category}`} class="hover:text-fg">{categoryLabel(d.category)}</a> /
      <span class="text-fg">{d.name}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <SkinPreview skin={skin} />

        <div class="mt-6 rounded-t-md border border-border bg-surface p-5">
          <h2 class="text-sm font-semibold tracking-caps uppercase text-meta">About this skin</h2>
          <div class="prose-invert mt-3 max-w-none text-fg-2">
            <Content />
          </div>
        </div>

        <RelatedSkins skin={skin} all={await getCollection('skins')} />
      </div>

      <aside class="space-y-5">
        <header>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{categoryLabel(d.category)}</span>
            <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{d.mood}</span>
            <span class="color-dot" style={`--skin-color:${d.color}`} title={`Accent ${d.color}`} aria-hidden="true"></span>
          </div>
          <h1 class="mt-3 font-display text-3xl font-semibold text-fg">{d.name}</h1>
          <p class="mt-2 flex items-center gap-1.5 text-sm text-muted">
            <User size={16} /> by {d.author}
          </p>
          <p class="mt-3 text-fg-2">{d.description}</p>

          <div class="mt-4 flex flex-wrap gap-4 text-sm text-meta">
            <span class="inline-flex items-center gap-1"><Download size={16} /> {d.stats.installs.toLocaleString()} installs</span>
            <span class="inline-flex items-center gap-1"><Heart size={16} /> {d.stats.likes.toLocaleString()} likes</span>
            <span class="inline-flex items-center gap-1"><CalendarDays size={16} /> Updated {d.updatedAt.toISOString().slice(0, 10)}</span>
          </div>

          <div class="mt-4">
            <span class="text-xs font-semibold tracking-caps uppercase text-meta">Compatible with</span>
            <div class="mt-2"><CompatibleBadges skin={skin} /></div>
          </div>
        </header>

        <InstallBlock skin={skin} />

        <a
          href={d.sourceUrl}
          class="inline-flex items-center gap-1.5 rounded-t-sm border border-border px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent"
          rel="nofollow noopener"
          target="_blank"
        >
          <ExternalLink size={16} /> Open source
        </a>

        <div class="border-t border-border pt-4">
          <ReportLink skin={skin} />
        </div>
      </aside>
    </div>
  </article>
</Base>
