---
import Base from '../../layouts/Base.astro';
import Steps from '../../components/Steps.astro';
import { ShieldCheck, Wrench, CircleAlert } from '@lucide/astro';
import { SUPPORTED_LOCALES, type Locale, localizedPath } from '../../i18n/config.ts';
import { makeT } from '../../i18n/index.ts';

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params as { lang?: Locale };
const t = makeT(lang);

const steps = [
  { title: t('tutorial.steps.1.title'), body: t('tutorial.steps.1.body') },
  { title: t('tutorial.steps.2.title'), body: t('tutorial.steps.2.body') },
  { title: t('tutorial.steps.3.title'), body: t('tutorial.steps.3.body') },
  { title: t('tutorial.steps.4.title'), body: t('tutorial.steps.4.body') },
];

// Engine comparison (from site.ts ENGINES, kept inline for the tutorial table)
const engines = [
  { name: 'Codex Dream Skin', platforms: 'macOS, Windows', style: 'Agent prompt / preset', note: 'Core open-source engine; local CDP injection, no app modification.' },
  { name: 'Codex Skin Manager', platforms: 'macOS, Windows', style: 'Built-in manager', note: '14 built-in themes plus a theme creator and Codex Skill.' },
  { name: 'Codex Themes (desktop)', platforms: 'macOS', style: '.codextheme import', note: 'Gallery and creator center at theme.codexguide.ai.' },
  { name: 'ReTheme', platforms: 'macOS, Windows', style: 'Signed themes', note: 'Tauri-based; signed, updatable, community themes.' },
  { name: 'Codex Themes CLI', platforms: 'Cross-platform', style: 'CLI /theme', note: 'Validate, preview, apply, rollback, export palettes.' },
  { name: 'Codepilot', platforms: 'Cross-platform', style: 'Built-in TUI /skin', note: 'Codex CLI distribution with 16 built-in TUI skins.' },
];

const troubleshooting = [
  { problem: 'Prompt applies but nothing visibly changes', fix: 'Confirm the engine is running and pointed at the right Codex window. Restart Codex Desktop, then re-apply.' },
  { problem: 'Skin looks different from the preview', fix: 'Previews approximate the source palette. Check the source link for the exact theme file and version.' },
  { problem: 'Codex updated and the skin stopped working', fix: 'Use the engine\'s restore-to-default option, then re-apply. Keeping the source link makes this a two-minute fix.' },
  { problem: 'CLI /theme says no themes installed', fix: 'Run the port install script first, then reopen the CLI prompt. Some ports cache colors at startup.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t('tutorial.title'),
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.body,
  })),
};
---
<Base
  title={t('tutorial.title')}
  description={t('tutorial.description')}
  locale={lang}
  jsonLd={jsonLd}
>
  <div class="container-x max-w-3xl py-10">
    <h1 class="text-3xl font-semibold text-fg">{t('tutorial.h1')}</h1>
    <p class="mt-2 text-muted">{t('tutorial.subtitle')}</p>

    <div class="callout mt-6">
      <ShieldCheck size={24} class="shrink-0 text-accent" />
      <div>
        <h2 class="font-semibold text-fg">{t('tutorial.beforeStart')}</h2>
        <p class="mt-1 text-sm text-muted">
          {t('tutorial.beforeStartBody').replace('127.0.0.1', '<code class="font-mono text-fg-2">127.0.0.1</code>')}
        </p>
      </div>
    </div>

    <div class="mt-8">
      <Steps steps={steps} />
    </div>

    <h2 class="mt-10 text-xl font-semibold text-fg">{t('tutorial.tips')}</h2>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-muted">
      <li>{t('tutorial.tips.1')}</li>
      <li>{t('tutorial.tips.2')}</li>
      <li>{t('tutorial.tips.3')}</li>
      <li>{t('tutorial.tips.4')}</li>
    </ul>

    <div class="callout mt-10">
      <Wrench size={24} class="shrink-0 text-accent" />
      <div>
        <h2 class="font-semibold text-fg">{t('tutorial.choosingEngine')}</h2>
        <p class="mt-1 text-sm text-muted">
          {t('tutorial.choosingEngineBody')}
        </p>
      </div>
    </div>
    <div class="mt-4 overflow-x-auto rounded-t-md border border-border">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-border bg-surface">
          <tr>
            <th class="px-4 py-3 font-semibold text-fg">{t('tutorial.engine.cols.engine')}</th>
            <th class="px-4 py-3 font-semibold text-fg">{t('tutorial.engine.cols.platforms')}</th>
            <th class="px-4 py-3 font-semibold text-fg">{t('tutorial.engine.cols.style')}</th>
            <th class="hidden px-4 py-3 font-semibold text-fg md:table-cell">{t('tutorial.engine.cols.notes')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {engines.map((e) => (
            <tr>
              <td class="px-4 py-3 font-medium text-fg">{e.name}</td>
              <td class="px-4 py-3 text-muted">{e.platforms}</td>
              <td class="px-4 py-3 text-muted">{e.style}</td>
              <td class="hidden px-4 py-3 text-muted md:table-cell">{e.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="callout mt-10">
      <CircleAlert size={24} class="shrink-0 text-accent" />
      <div>
        <h2 class="font-semibold text-fg">{t('tutorial.troubleshooting')}</h2>
        <p class="mt-1 text-sm text-muted">{t('tutorial.troubleshootingBody')}</p>
      </div>
    </div>
    <ul class="mt-4 space-y-4">
      {troubleshooting.map((t) => (
        <li class="rounded-t-md border border-border bg-surface p-4">
          <h3 class="text-sm font-semibold text-fg">{t.problem}</h3>
          <p class="mt-1 text-sm text-muted">{t.fix}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-sm text-muted">
      Need the short version? See the <a href={localizedPath('/install', lang)} class="text-accent hover:underline">install guide</a>,
      the <a href={localizedPath('/faq', lang)} class="text-accent hover:underline">FAQ</a>, or the
      <a href={localizedPath('/blog/how-to-install-codex-skins', lang)} class="text-accent hover:underline">full install blog post</a>.
    </p>
  </div>
</Base>
