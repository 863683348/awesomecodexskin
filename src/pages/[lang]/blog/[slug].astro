---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { CalendarDays, ArrowLeft, ExternalLink } from '@lucide/astro';
import { SITE } from '../../../lib/site.ts';
import { absolutePreview } from '../../../lib/skins.ts';
import { SUPPORTED_LOCALES, type Locale, localizedPath } from '../../../i18n/config.ts';
import { makeT } from '../../../i18n/index.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return SUPPORTED_LOCALES.flatMap((lang) =>
    posts.map((post) => ({
      params: { lang, slug: post.id },
      props: { post, lang },
    }))
  );
}

const { post, lang = 'en' } = Astro.props as { post: any; lang?: Locale };
const t = makeT(lang);
const { Content } = await render(post);
const d = post.data;

// Resolve related skins (valid slugs only) for internal linking
const allSkins = await getCollection('skins');
const skinBySlug = new Map(allSkins.map((s) => [s.id, s]));
const related = d.relatedSkins
  .map((slug) => skinBySlug.get(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}${localizedPath('/blog/', lang)}` },
        { '@type': 'ListItem', position: 3, name: d.title, item: `${SITE.url}${localizedPath(`/blog/${post.id}/`, lang)}` },
      ],
    },
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: d.pubDate.toISOString(),
      dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      mainEntityOfPage: `${SITE.url}${localizedPath(`/blog/${post.id}/`, lang)}`,
      ...(d.coverImage ? { image: absolutePreview({ data: { previewImage: d.coverImage } } as any, SITE.url) } : {}),
    },
  ],
};
---
<Base
  title={`${d.title} — Codex Skin Blog`}
  description={d.description}
  image={d.coverImage}
  type="article"
  locale={lang}
  jsonLd={jsonLd}
>
  <article class="container-x max-w-3xl py-10">
    <nav class="mb-6 text-sm text-meta" aria-label="Breadcrumb">
      <a href={localizedPath('/blog', lang)} class="inline-flex items-center gap-1 hover:text-fg">
        <ArrowLeft size={14} /> {t('blog.backToList')}
      </a>
    </nav>

    <header>
      <div class="flex flex-wrap items-center gap-2">
        {d.tags.map((t) => (
          <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs capitalize text-muted">{t}</span>
        ))}
        <span class="inline-flex items-center gap-1 text-xs text-meta">
          <CalendarDays size={14} />
          <time datetime={d.pubDate.toISOString().slice(0, 10)}>{d.pubDate.toISOString().slice(0, 10)}</time>
        </span>
      </div>
      <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-fg">{d.title}</h1>
      <p class="mt-3 text-base text-muted">{d.description}</p>
    </header>

    {d.coverImage && (
      <img
        src={d.coverImage}
        alt={d.title}
        class="mt-6 aspect-video w-full rounded-t-md border border-border object-cover"
        loading="eager"
      />
    )}

    <div class="prose-invert mt-8 max-w-none text-fg-2">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="mt-12 rounded-t-md border border-border bg-surface p-5">
        <h2 class="text-sm font-semibold tracking-caps uppercase text-meta">{t('blog.relatedSkins')}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {related.map((s) => (
            <a
              href={localizedPath(`/skins/${s.id}`, lang)}
              class="group flex items-center gap-3 rounded-t-sm border border-border p-3 hover:border-accent"
            >
              {s.data.previewImage ? (
                <img
                  src={s.data.previewImage}
                  alt={`${s.data.name} preview`}
                  class="h-14 w-20 shrink-0 rounded-t-sm border border-border object-cover"
                  loading="lazy"
                />
              ) : (
                <span class="h-14 w-20 shrink-0 rounded-t-sm border border-border" style={`background:${s.data.color}`} />
              )}
              <span class="min-w-0">
                <span class="block truncate text-sm font-semibold text-fg group-hover:text-accent">{s.data.name}</span>
                <span class="block text-xs text-muted">{t('skin.installs', { n: s.data.stats.installs.toLocaleString() })}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="mt-4 text-sm text-muted">
          {t('blog.browseAllSkins')} <a href={localizedPath('/skins', lang)} class="inline-flex items-center gap-1 text-accent hover:underline">skins <ExternalLink size={13} /></a>.
        </p>
      </section>
    )}
  </article>
</Base>
