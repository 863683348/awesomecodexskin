      </section>

      <section>
        <h2 class="text-xl font-semibold text-fg mt-6 mb-3">{t('legal.privacy.s9.title')}</h2>
        <p>{t('legal.privacy.s9.body')}</p>
      </section>
    </div>

    <div class="mt-12 pt-6 border-t border-border">
      <p class="text-sm text-muted">
        {t('legal.privacy.contact')} <a href="mailto:hi@awesomecodexskin.com" class="text-accent hover:underline">hi@awesomecodexskin.com</a>
      </p>
    </div>
  </div>
</Base>
