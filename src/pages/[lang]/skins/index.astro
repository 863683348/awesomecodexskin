---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FacetSidebar from '../../../components/FacetSidebar.astro';
import SkinCard from '../../../components/SkinCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import SubmitCTA from '../../../components/SubmitCTA.astro';
import { sortByNewest, itemListJsonLd } from '../../../lib/skins.ts';
import { CATEGORIES, categoryLabel } from '../../../lib/site.ts';
import { SUPPORTED_LOCALES, type Locale, localizedPath } from '../../../i18n/config.ts';
import { makeT } from '../../../i18n/index.ts';

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang = 'en' } = Astro.params as { lang?: Locale };
const t = makeT(lang);

const all = await getCollection('skins');
const ordered = sortByNewest(all);
const jsonLd = itemListJsonLd(ordered.slice(0, 24));

// Per-category counts for the quick-nav strip (drives internal links to category pages)
const counts = new Map<string, number>();
for (const s of all) {
  counts.set(s.data.category, (counts.get(s.data.category) ?? 0) + 1);
}
const navCats = CATEGORIES.filter((c) => (counts.get(c.slug) ?? 0) > 0);
---
<Base
  title={t('skins.title')}
  description={t('skins.description')}
  locale={lang}
  jsonLd={jsonLd}
>
  <div class="container-x grid gap-8 py-8 lg:grid-cols-[280px_1fr]">
    <FacetSidebar defaultSort="newest" />

    <section>
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h1 class="text-2xl font-semibold text-fg">{t('home.section.allSkins')}</h1>
        <span class="text-sm text-muted">{t('skins.count', { n: ordered.length })}</span>
      </div>

      <nav class="mb-8 flex flex-wrap gap-2" aria-label={t('skins.quickNav')}>
        {navCats.map((c) => (
          <a
            href={localizedPath(`/skins/category/${c.slug}`, lang)}
            class="inline-flex items-center gap-1.5 rounded-t-pill border border-border px-3 py-1.5 text-xs text-muted hover:border-accent hover:text-accent"
          >
            {categoryLabel(c.slug)}
            <span class="text-meta">({counts.get(c.slug)})</span>
          </a>
        ))}
        <a
          href={localizedPath('/tutorial', lang)}
          class="inline-flex items-center gap-1.5 rounded-t-pill border border-border px-3 py-1.5 text-xs text-muted hover:border-accent hover:text-accent"
        >
          {t('skins.installGuide')}
        </a>
      </nav>

      <div id="skin-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {ordered.map((s) => (
          <SkinCard skin={s} locale={lang} />
        ))}
      </div>

      <EmptyState variant="no-results" />

      <div class="mt-8 flex justify-center">
        <button id="load-more" type="button" class="hidden rounded-t-pill border border-border px-6 py-3 text-sm text-fg hover:border-accent hover:text-accent">
          {t('home.loadMore')}
        </button>
      </div>

      <div class="mt-10">
        <SubmitCTA />
      </div>
    </section>
  </div>
</Base>

<script>
  import { initBrowse } from '../../../lib/browse-client.ts';
  initBrowse({
    grid: '#skin-grid',
    resultCount: '#result-count',
    empty: '#empty-state',
    loadMore: '#load-more',
    sort: '#facet-sort',
    facetCategory: '[data-facet="category"]',
    facetMood: '#facet-mood',
    facetPlatform: '[data-facet="platform"]',
    facetColor: '#facet-color',
    pageSize: 24,
    sortDefault: 'newest',
  });
</script>
