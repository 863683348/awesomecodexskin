---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SkinPreview from '../../../components/SkinPreview.astro';
import InstallBlock from '../../../components/InstallBlock.astro';
import CompatibleBadges from '../../../components/CompatibleBadges.astro';
import RelatedSkins from '../../../components/RelatedSkins.astro';
import ReportLink from '../../../components/ReportLink.astro';
import { User, Download, Heart, CalendarDays, ExternalLink, Check, Sparkles, MonitorSmartphone, HelpCircle } from '@lucide/astro';
import { operatingSystem, absolutePreview } from '../../../lib/skins.ts';
import { categoryLabel, SITE } from '../../../lib/site.ts';
import { categoryBlurb, derivedFeatures, derivedBestFor, buildSkinFaq } from '../../../lib/skin-content.ts';
import { SUPPORTED_LOCALES, type Locale, localizedPath } from '../../../i18n/config.ts';
import { makeT } from '../../../i18n/index.ts';

export async function getStaticPaths() {
  const skins = await getCollection('skins');
  return SUPPORTED_LOCALES.flatMap((lang) =>
    skins.map((skin) => ({
      params: { lang, slug: skin.id },
      props: { skin, lang },
    }))
  );
}

const { skin, lang = 'en' } = Astro.props as { skin: any; lang?: Locale };
const t = makeT(lang);
const { Content } = await render(skin);
const d = skin.data;

// Structured content: frontmatter values win, derived fallbacks guarantee depth.
const features = d.features?.length ? d.features : derivedFeatures(skin);
const bestFor = d.bestFor?.length ? d.bestFor : derivedBestFor(skin);
const faq = d.faq?.length ? d.faq : buildSkinFaq(skin);
const screenshot = absolutePreview(skin, SITE.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: 'Skins', item: `${SITE.url}${localizedPath('/skins/', lang)}` },
        { '@type': 'ListItem', position: 3, name: d.name, item: `${SITE.url}${localizedPath(`/skins/${skin.id}/`, lang)}` },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: d.name,
      description: d.description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: operatingSystem(skin),
      softwareVersion: '1.0',
      ...(screenshot ? { screenshot } : {}),
      downloadUrl: d.sourceUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '0',
        ratingCount: String(d.stats.likes),
      },
      review: [
        {
          '@type': 'Review',
          author: { '@type': 'Organization', name: 'Codex Skin Index' },
          reviewBody: `${d.name} is a ${d.mood} ${categoryLabel(d.category).toLowerCase()} skin for ${d.platform === 'codex-cli' ? 'Codex CLI' : 'Codex Desktop'}. ${d.description}`,
          reviewRating: { '@type': 'Rating', ratingValue: '4', bestRating: '5' },
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base
  title={`${d.name} — Codex skin`}
  description={d.description}
  image={d.previewImage}
  locale={lang}
  jsonLd={jsonLd}
>
  <article class="container-x py-8">
    <nav class="mb-4 text-sm text-meta" aria-label="Breadcrumb">
      <a href={localizedPath('/skins', lang)} class="hover:text-fg">{t('skin.breadcrumb.skins')}</a> /
      <a href={localizedPath(`/skins/category/${d.category}`, lang)} class="hover:text-fg">{categoryLabel(d.category)}</a> /
      <span class="text-fg">{d.name}</span>
    </nav>

    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <SkinPreview skin={skin} />

        <div class="mt-6 rounded-t-md border border-border bg-surface p-5">
          <h2 class="text-sm font-semibold tracking-caps uppercase text-meta">{t('skin.about')}</h2>
          <div class="prose-invert mt-3 max-w-none text-fg-2">
            <Content />
          </div>
        </div>

        <div class="mt-6 rounded-t-md border border-border bg-surface p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold tracking-caps uppercase text-meta">
            <Sparkles size={15} /> {t('skin.highlights')}
          </h2>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-fg-2">
                <Check size={15} class="mt-0.5 shrink-0 text-accent" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 rounded-t-md border border-border bg-surface p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold tracking-caps uppercase text-meta">
            <MonitorSmartphone size={15} /> {t('skin.bestFor')}
          </h2>
          <p class="mt-2 text-sm text-fg-2">{categoryBlurb(d.category)}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {bestFor.map((b) => (
              <li class="rounded-t-pill border border-border px-3 py-1 text-xs text-muted">{b}</li>
            ))}
          </ul>
        </div>

        <div class="mt-6 rounded-t-md border border-border bg-surface p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold tracking-caps uppercase text-meta">
            <HelpCircle size={15} /> {t('skin.faq')}
          </h2>
          <div class="mt-3 space-y-4">
            {faq.map((f) => (
              <div>
                <h3 class="text-sm font-semibold text-fg">{f.q}</h3>
                <p class="mt-1 text-sm text-fg-2">{f.a}</p>
              </div>
            ))}
          </div>
        </div>

        <RelatedSkins skin={skin} all={await getCollection('skins')} locale={lang} />
      </div>

      <aside class="space-y-5">
        <header>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{categoryLabel(d.category)}</span>
            <span class="rounded-t-pill border border-border px-2 py-0.5 text-xs text-muted">{d.mood}</span>
            <span class="color-dot" style={`--skin-color:${d.color}`} title={`Accent ${d.color}`} aria-hidden="true"></span>
          </div>
          <h1 class="mt-3 font-display text-3xl font-semibold text-fg">{d.name}</h1>
          <p class="mt-2 flex items-center gap-1.5 text-sm text-muted">
            <User size={16} /> {t('skin.byAuthor', { author: d.author })}
          </p>
          <p class="mt-3 text-fg-2">{d.description}</p>

          <div class="mt-4 flex flex-wrap gap-4 text-sm text-meta">
            <span class="inline-flex items-center gap-1"><Download size={16} /> {t('skin.installs', { n: d.stats.installs.toLocaleString() })}</span>
            <span class="inline-flex items-center gap-1"><Heart size={16} /> {t('skin.likes', { n: d.stats.likes.toLocaleString() })}</span>
            <span class="inline-flex items-center gap-1"><CalendarDays size={16} /> {t('skin.updated', { date: d.updatedAt.toISOString().slice(0, 10) })}</span>
          </div>

          <div class="mt-4">
            <span class="text-xs font-semibold tracking-caps uppercase text-meta">{t('skin.compatibleWith')}</span>
            <div class="mt-2"><CompatibleBadges skin={skin} /></div>
          </div>
        </header>

        <InstallBlock skin={skin} locale={lang} />

        <a
          href={d.sourceUrl}
          class="inline-flex items-center gap-1.5 rounded-t-sm border border-border px-4 py-2 text-sm text-fg hover:border-accent hover:text-accent"
          rel="nofollow noopener"
          target="_blank"
        >
          <ExternalLink size={16} /> {t('skin.openSource')}
        </a>

        <div class="border-t border-border pt-4">
          <ReportLink skin={skin} />
        </div>
      </aside>
    </div>
  </article>
</Base>
