---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { Clock, Shield, Mail, Megaphone } from '@lucide/astro';
---
<Base
  title="Contact — Codex Skin Index"
  description="Get in touch for advertising, partnerships, custom theme requests, or anything else. We reply within 1–2 business days."
>
  <div class="container-x grid gap-10 py-10 lg:grid-cols-[60%_40%]">
    <section>
      <h1 class="text-3xl font-semibold text-fg">Contact</h1>
      <p class="mt-2 max-w-xl text-muted">
        Advertising inquiries, partnership ideas, custom theme requests, or just a hello —
        pick a topic below and we will get back to you.
      </p>
      <div class="mt-6">
        <ContactForm />
      </div>
    </section>

    <aside class="space-y-4">
      <div class="rounded-t-md border border-border bg-surface p-5">
        <h2 class="flex items-center gap-2 font-semibold text-fg"><Clock size={18} /> Response time</h2>
        <p class="mt-2 text-sm text-muted">1–2 business days. Sponsorship briefs are prioritized.</p>
      </div>

      <div class="rounded-t-md border border-border bg-surface p-5">
        <h2 class="flex items-center gap-2 font-semibold text-fg"><Megaphone size={18} /> Advertising</h2>
        <p class="mt-2 text-sm text-muted">
          Pick "Advertising / Sponsor slot" and include your site URL, target audience,
          and budget range. We will reply with our media kit and current rate card.
        </p>
      </div>

      <div class="rounded-t-md border border-border bg-surface p-5">
        <h2 class="flex items-center gap-2 font-semibold text-fg"><Shield size={18} /> Privacy</h2>
        <p class="mt-2 text-sm text-muted">
          Your email is only used to reply. We do not sell or share contact data, and we do
          not run any third-party analytics on this form.
        </p>
      </div>

      <div class="rounded-t-md border border-border bg-surface p-5">
        <h2 class="flex items-center gap-2 font-semibold text-fg"><Mail size={18} /> Direct email</h2>
        <p class="mt-2 text-sm text-muted">
          Prefer email? Reach us at
          <a href="mailto:hi@awesomecodexskin.com" class="text-accent hover:underline">hi@awesomecodexskin.com</a>.
        </p>
      </div>
    </aside>
  </div>
</Base>