---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SkinCard from '../components/SkinCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { featuredFirst, sortByNewest } from '../lib/skins.ts';
import { ArrowRight, Home, Palette, BookOpen, Send } from '@lucide/astro';

const all = await getCollection('skins');
const featured = featuredFirst(all).filter((s) => s.data.featured);
// Prefer featured; fall back to newest so the block is never empty.
const popular = (featured.length >= 2 ? featured : sortByNewest(all)).slice(0, 4);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '404 — page not found',
  description: 'That page does not exist. Browse Codex skins, read the guides, or submit a skin.',
  url: 'https://awesomecodexskin.com/404',
};
---
<Base
  title="404 — page not found"
  description="That page does not exist. Browse Codex skins, read the guides, or install a new look."
  jsonLd={jsonLd}
>
  <div class="container-x max-w-3xl py-20 text-center">
    <p class="text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-fg">This skin seems to have escaped the workspace</h1>
    <p class="mt-2 text-muted">
      The page you're looking for doesn't exist or was moved. Here's where you can go instead:
    </p>

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 rounded-t-pill bg-accent px-5 py-3 text-sm font-medium text-accent-on hover:bg-accent-hover"
      >
        <Home size={16} /> Back to home
      </a>
      <a
        href="/skins/"
        class="inline-flex items-center justify-center gap-2 rounded-t-pill border border-border px-5 py-3 text-sm text-fg hover:border-accent hover:text-accent"
      >
        <Palette size={16} /> Browse all skins
      </a>
      <a
        href="/blog/"
        class="inline-flex items-center justify-center gap-2 rounded-t-pill border border-border px-5 py-3 text-sm text-fg hover:border-accent hover:text-accent"
      >
        <BookOpen size={16} /> Read the guides
      </a>
      <a
        href="/submit/"
        class="inline-flex items-center justify-center gap-2 rounded-t-pill border border-border px-5 py-3 text-sm text-fg hover:border-accent hover:text-accent"
      >
        <Send size={16} /> Submit a skin
      </a>
    </div>

    <div class="mx-auto mt-8 max-w-md">
      <SearchBar placeholder="Search skins, moods, engines…" />
    </div>

    {popular.length > 0 && (
      <section class="mt-12 text-left">
        <h2 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-caps text-meta">
          Popular skins <ArrowRight size={13} />
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {popular.map((s) => (
            <SkinCard skin={s} compact locale="en" />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
